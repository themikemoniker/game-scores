      "html": "<div class=\"ds-plate\"><span class=\"ds-rank\">1</span><div class=\"ds-cover\"></div><div><h2 class=\"ds-title\"><a href=\"#\">Test Both</a></h2><p class=\"ds-meta\">2020 · PC, PS5</p><p class=\"ds-label\">Test Studio · RPG</p></div></div>",
      "css": ".ds-plate{display:grid;grid-template-columns:5rem 6rem minmax(0,1fr);align-items:center;gap:var(--space-6);padding:var(--space-6) 0;border-bottom:1px solid var(--rule);}.ds-rank{align-self:start;font-family: var(--font-ui);font-weight:800;font-stretch:125%;font-size:var(--text-2xl);line-height:1;font-variant-numeric:tabular-nums;color:var(--ink-soft);}.ds-cover{aspect-ratio:264/374;border-radius:var(--radius-cover);background:var(--stock-sunk);box-shadow:var(--shadow-hang);transition:transform var(--fast) var(--ease-out),box-shadow var(--fast) var(--ease-out);}.ds-plate:hover .ds-cover{transform:translateY(-2px);box-shadow:var(--shadow-lift);}.ds-title{margin:0;font-family: var(--font-ui);font-size:var(--text-xl);font-weight:700;letter-spacing:-0.01em;line-height:1.25;}.ds-title a{color:var(--ink);text-decoration:none;}.ds-plate:hover .ds-title a{text-decoration:underline;text-decoration-thickness:2px;}.ds-meta{margin:var(--space-1) 0 0;font-family: var(--font-ui);font-size:var(--text-sm);color:var(--ink-soft);}.ds-label{margin:var(--space-3) 0 0;font-family:var(--font-read);color:var(--ink);}"
