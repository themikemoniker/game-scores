      "css": ".ds-meter{display:flex;flex-direction:column;gap:var(--space-2);width:11rem;padding-bottom:1.1rem;}.ds-val{font-family: var(--font-ui);font-weight:800;font-stretch:112%;font-size:2.75rem;line-height:0.9;letter-spacing:-0.03em;font-variant-numeric:tabular-nums;color:var(--c);}.ds-scale{position:relative;display:block;height:0.5rem;background:var(--stock-sunk);box-shadow:inset 0 0 0 1px var(--rule);}.ds-scale::after{content:'';position:absolute;left:70%;top:-0.25rem;bottom:-0.25rem;width:2px;margin-left:-1px;background:var(--ink);}.ds-scale::before{content:'70';position:absolute;left:70%;top:calc(100% + 0.3rem);transform:translateX(-50%);font-family: var(--font-ui);font-size:var(--text-xs);font-weight:700;line-height:1;color:var(--ink-soft);}.ds-fill{position:absolute;inset:0 auto 0 0;width:calc(var(--score) * 1%);background:var(--c);}"
