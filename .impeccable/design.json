      "css": ".ds-un{display:flex;flex-direction:column;gap:var(--space-2);width:11rem;}.ds-un-val{font-family: var(--font-ui);font-size:var(--text-lg);font-weight:700;line-height:1.2;color:var(--ink-soft);}.ds-un-scale{position:relative;display:block;height:0.5rem;border:1px dashed var(--rule-strong);}.ds-un-scale::after{content:'';position:absolute;left:70%;top:-0.25rem;bottom:-0.25rem;width:2px;margin-left:-1px;background:var(--rule-strong);}"
