      "css": ".ds-btn{display:inline-flex;align-items:center;min-height:2.75rem;padding:0 var(--space-5);font-family: var(--font-ui);font-size:var(--text-sm);font-weight:650;color:var(--wall-ink);background:var(--wall);border:1px solid var(--wall);border-radius:var(--radius-control);cursor:pointer;transition:background-color var(--fast) var(--ease-out),border-color var(--fast) var(--ease-out),color var(--fast) var(--ease-out);}.ds-btn:hover{background:var(--wall-deep);}.ds-btn:focus-visible{outline:2px solid var(--focus);outline-offset:3px;}@media (prefers-color-scheme: dark){.ds-btn{color:var(--wall);background:var(--wall-ink);border-color:var(--wall-ink);}.ds-btn:hover{background:var(--wall-ink-soft);}}"
